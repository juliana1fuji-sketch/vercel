<!DOCTYPE html><html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Birthday da Juliana 🎂</title>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #f8e1e7, #f1c6c6, #f6d3cb);
      color: #4d2c2c;
      text-align: center;
      padding: 40px;
    }.container {
  background-color: #fff8f8;
  border-radius: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  max-width: 400px;
  margin: 0 auto;
  padding: 30px;
}

h1 {
  color: #b76e79;
  font-size: 2em;
}

p {
  color: #5b3b3b;
  margin-bottom: 20px;
}

input[type="text"] {
  width: 100%;
  padding: 10px;
  margin: 10px 0;
  border: 1px solid #e6b7b7;
  border-radius: 10px;
  font-size: 1em;
}

.buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 15px;
}

button {
  padding: 10px 20px;
  border: none;
  border-radius: 12px;
  background-color: #b76e79;
  color: white;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.3s ease;
}

button:hover {
  background-color: #a65e68;
}

#mensagem {
  display: none;
  margin-top: 25px;
  font-size: 1.1em;
  color: #8b4b56;
  font-weight: bold;
}

  </style>
</head>
<body>
  <div class="container">
    <h1>🎉 Birthday da Juliana 🎉</h1>
    <p><strong>Endereço:</strong><br>Rua Deputado Cunha Bueno, 356<br>Vila Giglio - Atibaia</p>
    <p>Confirme sua presença:</p><input type="text" id="nome" placeholder="Digite seu nome" />

<div class="buttons">
  <button onclick="confirmarPresenca('Vou')">Vou 🎈</button>
  <button onclick="confirmarPresenca('Não vou')">Não vou 💌</button>
</div>

<div id="mensagem">Obrigada pela resposta! 💖</div>

  </div>  <script>
    function confirmarPresenca(opcao) {
      const nome = document.getElementById('nome').value.trim();
      const msg = document.getElementById('mensagem');

      if (!nome) {
        alert('Por favor, digite seu nome antes de confirmar.');
        return;
      }

      // Aqui você poderia futuramente enviar os dados para um banco ou planilha
      console.log(`${nome} respondeu: ${opcao}`);

      msg.style.display = 'block';
      document.getElementById('nome').value = '';
    }
  </script></body>
</html>
